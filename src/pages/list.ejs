<!DOCTYPE html>
<html lang="en">
<head>
  <!-- Метадані документа та налаштування відображення -->
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <!-- Пропорційне масштабування зображень у вузькому вікні -->
  <link rel="stylesheet" href="styles/images.css">
  <title data-i18n="courses.title2">Courses Catalog | Codeva</title>
  <meta name="description" content="Explore our IT courses and build practical skills designed for every stage of your learning journey.">
</head>
<body>
  <!-- Посилання швидкого переходу до основного вмісту -->
  <a class="skip-link" href="#main" data-i18n="courses.skipLink">Skip to content</a>

  <!-- Шапка сайту зі спільного EJS-шаблону -->
  <%- include('../partials/header', { active: 'courses' }) %>

  <!-- Основний вміст каталогу курсів -->
  <main id="main" tabindex="-1">
    <!-- Заголовок та опис каталогу -->
    <section class="courses-intro" aria-labelledby="courses-title">
      <h1 class="courses-intro__title" id="courses-title" data-i18n="courses.title">Explore our courses</h1>
      <p class="courses-intro__description" data-i18n="courses.coursesIntroDescription">
        Build practical skills with courses designed for every stage of your learning journey.
      </p>

      <!-- Кнопки фільтрування за категоріями -->
      <aside class="filters" aria-label="Course Categories Filter" data-i18n-aria-label="courses.accessibleCourseCategoriesFilter">
        <ul class="filters__list">
          <li><button class="filters__btn filters__btn--active" type="button" data-i18n="courses.filtersBtn">All courses</button></li>
          <li><button class="filters__btn" type="button" data-i18n="courses.filtersBtn2">Frontend</button></li>
          <li><button class="filters__btn" type="button" data-i18n="courses.filtersBtn3">Backend</button></li>
          <li><button class="filters__btn" type="button" data-i18n="courses.filtersBtn4">UI/UX Design</button></li>
          <li><button class="filters__btn" type="button" data-i18n="courses.filtersBtn5">Data Science</button></li>
        </ul>
      </aside>
    </section>

    <!-- Повний перелік курсів -->
    <section class="courses-grid-section" aria-labelledby="all-courses-title">
      <h2 class="courses-grid-section__title" id="all-courses-title" data-i18n="courses.all">All courses</h2>

      <ul class="course-grid">
        <!-- Картка курсу 1: підключення спільного шаблону -->
        <li class="course-grid__item">
          <%- include('../partials/course-card', { course: courses[0] }) %>
        </li>

        <!-- Картка курсу 2: підключення спільного шаблону -->
        <li class="course-grid__item">
          <%- include('../partials/course-card', { course: courses[1] }) %>
        </li>

        <!-- Картка курсу 3: підключення спільного шаблону -->
        <li class="course-grid__item">
          <%- include('../partials/course-card', { course: courses[2] }) %>
        </li>

        <!-- Картка курсу 4: підключення спільного шаблону -->
        <li class="course-grid__item">
          <%- include('../partials/course-card', { course: courses[3] }) %>
        </li>

        <!-- Картка курсу 5: підключення спільного шаблону -->
        <li class="course-grid__item">
          <%- include('../partials/course-card', { course: courses[4] }) %>
        </li>

        <!-- Картка курсу 6: підключення спільного шаблону -->
        <li class="course-grid__item">
          <%- include('../partials/course-card', { course: courses[5] }) %>
        </li>
      </ul>
    </section>
  </main>

  <!-- Підвал сайту зі спільного EJS-шаблону -->
  <%- include('../partials/footer', { active: 'courses' }) %>
</body>
</html>
